{
  // Cursor Cloud Agent environment for vantage-movers-server.
  // JSON schema: https://www.cursor.com/schemas/environment.schema.json
  "name": "vantage-movers-server",
  "user": "ubuntu",
  // Base image: system-level toolchain (Node 22, pnpm, MongoDB 8.0). Paths are
  // relative to this .cursor folder. Because `build` is set, the Dockerfile is
  // the source of truth and no snapshot is used.
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Dependency refresh on every agent start, after the latest changes are
  // pulled. Idempotent and fast (uses pnpm's content-addressable store).
  "install": "pnpm install",
  // Per-boot: local mongod replica set + gitignored .env. Returns when PRIMARY.
  // The API process itself stays in the `api` terminal so its logs stay visible.
  "start": "bash .cursor/scripts/ensure-cloud-runtime.sh",
  "ports": [
    { "name": "api", "port": 3000 },
    { "name": "mongo", "port": 27017 }
  ],
  // Long-running processes, started in a shared tmux session after install.
  "terminals": [
    {
      "name": "mongod",
      "description": "Local MongoDB 8.0 single-node replica set (rs0). Required because the API's write paths use multi-document transactions.",
      "command": "bash .cursor/scripts/start-mongo.sh"
    },
    {
      "name": "api",
      "description": "Express API on http://localhost:3000. Forces local Mongo + TEST_MODE=true and disables Sheets/RingCentral writes even when dashboard secrets inject an Atlas cluster URI."
      "command": "bash .cursor/scripts/start-api.sh"
    }
  ]
}
