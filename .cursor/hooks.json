{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/docs-drift-check.sh",
        "timeout": 15
      },
      {
        "command": ".cursor/hooks/business-logic-drift-check.sh",
        "timeout": 15
      },
      {
        "command": ".cursor/hooks/dangerous-change-guard.sh",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/dangerous-change-guard.sh",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/typecheck.sh",
        "timeout": 120,
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/test-related.sh",
        "timeout": 180,
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/lint.sh",
        "timeout": 120
      }
    ]
  }
}
