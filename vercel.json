{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/queues/sheet-sync-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "sheet-sync-events*",
          "retryAfterSeconds": 30
        }
      ]
    },
    "api/queues/lead-messaging-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "lead-messaging-events*",
          "retryAfterSeconds": 30
        }
      ]
    },
    "api/queues/best-relocation-ingestion-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "best-relocation-ingestion-events*",
          "retryAfterSeconds": 30
        }
      ]
    },
    "api/queues/reporting-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "reporting-delivery-events*",
          "retryAfterSeconds": 30
        }
      ]
    },
    "api/queues/granot-automation-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "granot-automation-events*",
          "retryAfterSeconds": 30
        }
      ]
    },
    "api/queues/granot-lifecycle-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "granot-lifecycle-events*",
          "retryAfterSeconds": 30
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/ringcentral-call-log-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/ringcentral-analytics-reconcile",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sheet-sync-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/booking-reconciliation-rematch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/lead-messaging-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cpl-corrections-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/notifications-digest-daily",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/best-relocation-ingest-heartbeat",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/reporting-delivery-heartbeat",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reporting-health-scan",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reporting-cleanup-janitor",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/granot-automation-heartbeat",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/granot-lifecycle-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reporting-test-artifact-janitor",
      "schedule": "0 4 * * *"
    }
  ]
}
