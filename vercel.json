{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    {
      "path": "/api/cron/ringcentral-call-log-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/ringcentral-analytics-reconcile",
      "schedule": "0 6 * * *"
    }
  ]
}
