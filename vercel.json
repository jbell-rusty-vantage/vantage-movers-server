{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/queues/sheet-sync-consumer.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "sheet-sync-events*",
          "retryAfterSeconds": 30
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/ringcentral-call-log-sync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/ringcentral-analytics-reconcile",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sheet-sync-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/notifications-digest-daily",
      "schedule": "0 12 * * *"
    }
  ]
}
