{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/quality/hook-entry.mjs --provider codex --event start",
            "timeout": 3,
            "statusMessage": "Record Vantage checkpoint activity"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/quality/hook-entry.mjs --provider codex --event prompt",
            "timeout": 3,
            "statusMessage": "Record Vantage checkpoint activity"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/quality/hook-entry.mjs --provider codex --event tool-start",
            "timeout": 3,
            "statusMessage": "Record Vantage checkpoint activity"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/quality/hook-entry.mjs --provider codex --event activity",
            "timeout": 3,
            "statusMessage": "Record Vantage checkpoint activity"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/quality/hook-entry.mjs --provider codex --event stop",
            "timeout": 3,
            "statusMessage": "Record Vantage checkpoint activity"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/quality/hook-entry.mjs --provider codex --event end",
            "timeout": 3,
            "statusMessage": "Record Vantage checkpoint activity"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/quality/hook-entry.mjs --provider codex --event interrupt",
            "timeout": 3,
            "statusMessage": "Record Vantage checkpoint activity"
          }
        ]
      }
    ]
  }
}