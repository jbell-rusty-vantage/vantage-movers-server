{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "express-serve-static-core"]
  },
  "include": ["api/**/*.ts", "scripts/**/*.ts", "types/**/*.d.ts"]
}
